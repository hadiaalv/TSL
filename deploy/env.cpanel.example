# Copy values into the server .env at:
#   /home/.../demo.summitstaffing.com.au/.env
#
# Then in cPanel → Setup Python App → RESTART

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

APP_HOST=0.0.0.0
APP_PORT=8000
# Absolute path recommended on cPanel (passenger_wsgi also defaults to ./data)
DATA_DIR=data
SEED_DEMO=false

PUBLIC_BASE_URL=https://demo.summitstaffing.com.au
AUTH_COOKIE_SECURE=true

AUTH_SECRET=replace-with-long-random-string
AUTH_USERNAME=admin
AUTH_PASSWORD=replace-with-strong-password
AUTH_SESSION_HOURS=168

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://demo.summitstaffing.com.au/api/google/callback
