[Unit]
Description=AI Chief of Staff
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/ai-chief-of-staff
EnvironmentFile=/opt/ai-chief-of-staff/.env
ExecStart=/opt/ai-chief-of-staff/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --proxy-headers --forwarded-allow-ips=*
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
